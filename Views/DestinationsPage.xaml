<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:TravelGuide.ViewModels"
    x:Class="TravelGuide.Views.DestinationsPage"
    Style="{StaticResource PageStyle}"
    Shell.NavBarIsVisible="False">

    <ContentPage.BindingContext>
        <vm:DestinationsViewModel/>
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Spacing="0" Padding="20,54,20,30">

            <Label Text="Destinations" Style="{StaticResource PageTitleLabel}" />
            <Label
                Text="Handpicked places that take your breath away"
                Style="{StaticResource PageSubtitleLabel}"
                Margin="0,4,0,24" />

            <CollectionView
                ItemsSource="{Binding Destinations}"
                SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="20" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame
                            CornerRadius="16"
                            Padding="0"
                            IsClippedToBounds="True"
                            HasShadow="True"
                            BorderColor="Transparent"
                            BackgroundColor="{StaticResource CardBackgroundColor}">

                            <VerticalStackLayout Spacing="0">
                                
                                <Grid HeightRequest="220">
                                    
                                    <Image
                                        Source="{Binding HeroImage}"
                                        Aspect="AspectFill"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Fill" />

                                    <BoxView VerticalOptions="End" HeightRequest="110">
                                        <BoxView.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="Transparent" Offset="0.0"/>
                                                <GradientStop Color="#CC000000"   Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </BoxView.Background>
                                    </BoxView>
                                    
                                    <Frame
                                        HorizontalOptions="End"
                                        VerticalOptions="Start"
                                        Margin="0,12,12,0"
                                        Padding="0"
                                        CornerRadius="20"
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        BackgroundColor="#55000000"
                                        BorderColor="Transparent"
                                        HasShadow="False">
                                        <Label
                                            Text="{Binding HeartIcon}"
                                            TextColor="{Binding HeartColor}"
                                            FontSize="20"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnHeartTapped" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </Frame>
                                    
                                    <VerticalStackLayout
                                        VerticalOptions="End"
                                        Padding="16,0,16,14"
                                        Spacing="3">
                                        <Label
                                            Text="{Binding Name}"
                                            Style="{StaticResource CardOverlayNameLabel}" />
                                        <HorizontalStackLayout Spacing="4">
                                            <Label Text="📍" FontSize="12" VerticalOptions="Center" />
                                            <Label
                                                Text="{Binding Location}"
                                                Style="{StaticResource CardOverlayCountryLabel}" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                </Grid>

                                <VerticalStackLayout Padding="16,12,16,14" Spacing="10">

                                    <Label
                                        Text="{Binding Description}"
                                        Style="{StaticResource MutedLabel}"
                                        MaxLines="2"
                                        LineBreakMode="TailTruncation" />

                                    <HorizontalStackLayout Spacing="2">
                                        <BindableLayout.ItemsSource>
                                            <Binding Path="Stars" />
                                        </BindableLayout.ItemsSource>
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <Label
                                                    Text="{Binding .}"
                                                    FontSize="16"
                                                    TextColor="{StaticResource PrimaryColor}" />
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </HorizontalStackLayout>

                                </VerticalStackLayout>
                            </VerticalStackLayout>

                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer
                                    Tapped="OnCardTapped"
                                    CommandParameter="{Binding Name}" />
                            </Frame.GestureRecognizers>

                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
